mass	1 12.011 # C_3
mass	2 12.011 # C_2
mass	3 12.011 # C_1
mass	4 12.011 # C_0
mass	5 1.008  # H_C

set	type 1 charge -0.18
set	type 2 charge -0.12
set	type 3 charge -0.06
set	type 4 charge  0.00
set	type 5 charge  0.06

# from KJ/mol to KCal/mol *0.239006

pair_style	lj/cut/coul/long 10.0
pair_modify	shift yes mix geometric
pair_coeff	1 1 0.066  3.5 # C_3
pair_coeff	2 2 0.066  3.5 # C_2
pair_coeff	3 3 0.066  3.5 # C_1
pair_coeff	4 4 0.066  3.5 # C_0
pair_coeff	5 5 0.030  2.5 # H_C

bond_style	harmonic
bond_coeff	1 268.0 1.529 # C-C
bond_coeff	2 340.0 1.090 # C-H

angle_style	harmonic
angle_coeff	1 58.35 112.7 # C-C-C
angle_coeff	2 37.50 110.7 # C-C-H
angle_coeff	3 33.00 107.8 # H-C-H

dihedral_style	opls
dihedral_coeff	1 1.3 -0.05  0.20  0.0 # C-C-C-C
dihedral_coeff	2 0.0  0.00  0.30  0.0 # C-C-C-H
dihedral_coeff	3 0.0  0.00  0.30  0.0 # H-C-C-H

special_bonds	lj/coul 0 0 0.5

kspace_style	pppm 1.0e-5

