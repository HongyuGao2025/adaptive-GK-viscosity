read_restart	nvt_100C_146MPa_1.restart

reset_timestep	0

variable		pxx equal pxx
variable		pyy equal pyy
variable		pzz equal pzz
variable		pxy equal pxy
variable		pxz equal pxz
variable		pyz equal pyz

include		force_field.system

neighbor		2.0 bin
neigh_modify	delay 0 every 1 check yes

fix		1 all nve
fix		2 all ave/time 1 100 100 v_pxx v_pyy v_pzz v_pxy v_pxz v_pyz file stress.dat

thermo_style	custom step temp pxx pyy pzz pxy pxz pyz
thermo		100

dump		1 all custom 100000 dump_wrap.lammpstrj id mol type x y z
dump_modify	1 sort id

timestep		1
run		10000000
write_restart	nve_1.restart
